{
  "name": "signature",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only iFVG trade journal.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --conditions=react-server db/cli-migrate.ts",
    "desktop": "electron .",
    "desktop:build": "next build && node scripts/assemble-standalone.mjs && electron-builder --win portable zip",
    "predesktop": "node scripts/ensure-electron.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "framer-motion": "^13.2.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.signature.journal",
    "productName": "Signature",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "asar": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable",
        "zip"
      ],
      "artifactName": "Signature-${version}-windows.${ext}"
    },
    "portable": {
      "artifactName": "Signature-portable-${version}.exe",
      "unicode": true,
      "unpackDirName": true,
      "splashImage": "assets/splash.bmp"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "db/migrations/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
